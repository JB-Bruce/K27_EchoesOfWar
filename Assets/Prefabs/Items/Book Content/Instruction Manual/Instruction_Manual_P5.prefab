  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "4 - V\xE9rifiez les valeurs indiqu\xE9es des dispositifs sur le dessus
    du bo\xEEtier. De gauche \xE0 droite face au bo\xEEtier, les valeurs correspondent
    \xE0 la pression, la temp\xE9rature et le d\xE9bit du carburant. Les valeurs
    optimales pour un moteur en phase de red\xE9marrage sont : \n\nPression = 3 bars\nTemp\xE9rature
    = 250\xB0C\nD\xE9bit = 5 L/s. \n\r\nSi les valeurs indiqu\xE9es sur le bo\xEEtier
    ne correspondent pas \xE0 ces valeurs, tournez les manivelles correspondantes
    jusqu\u2019\xE0 obtenir ces valeurs.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
